# Atak Pazarlama güvenlik
# Bu dosyayı VPS'te `.env` olarak kopyalayın. store.json'a dokunmayın.

PORT=3100
NODE_ENV=production

# Güçlü ve gizli tutun
ADMIN_PASSWORD=Buraya-Guclu-Sifre-Yazin
SESSION_SECRET=uzun-rastgele-bir-metin-yazin

# 1 = sadece siz (admin/taha). Personeli açmak için 0 yapın.
ATAK_OWNER_ONLY=1
ATAK_OWNER_USERNAMES=admin,taha

# İsteğe bağlı: sadece sizin IP'niz (boş = IP kilidi kapalı)
# ATAK_ALLOWED_IPS=1.2.3.4

# Giriş kodu (e-posta) — ŞİMDİLİK KAPALI. Mail kurunca 1 yapın.
ATAK_MFA_ENABLED=0
ATAK_MFA_TRUST_HOURS=6
# Yönetici (admin şifresi) kodunun gideceği adres
# ATAK_OWNER_EMAIL=siz@mail.com

# SMS Gateway (isteğe bağlı — panel Ayarlar → SMS)
# Herhangi bir SMS firması: Genel HTTP veya hazır preset (corvass/netgsm/…)
# SMS_ENABLED=1
# SMS_PROVIDER=generic
# SMS_ENDPOINT=https://api.ornek.com/sms/send
# SMS_METHOD=POST
# SMS_CONTENT_TYPE=form
# SMS_USERNAME=
# SMS_PASSWORD=
# SMS_ORIGINATOR=
